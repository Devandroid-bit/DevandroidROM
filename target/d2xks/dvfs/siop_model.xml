<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE siop_document [
<!ELEMENT siop_document (overheatcontrol?, modelsettings?, temperatures?, levels?, components, scenarios?)>
<!ELEMENT overheatcontrol (complex?)>
<!ELEMENT modelsettings (temperatures?, Skin?, sensors?)>
<!ELEMENT Skin EMPTY>
<!ATTLIST Skin type CDATA #REQUIRED>
<!ELEMENT sensors (LTB_SENSOR*)>
<!ELEMENT LTB_SENSOR EMPTY>
<!ATTLIST LTB_SENSOR type CDATA #REQUIRED>
<!ELEMENT temperatures (temp+)>
<!ELEMENT temp EMPTY>
<!ATTLIST temp
          type CDATA #REQUIRED
          default CDATA "1"
          min CDATA "1"
          max CDATA "1"
          step CDATA "1"
          init CDATA "5"
          hold CDATA "1"
          gap CDATA "0">
<!ELEMENT levels (level+)>
<!ELEMENT level EMPTY>
<!ATTLIST level
          id CDATA #REQUIRED
          temp CDATA #REQUIRED>
<!ELEMENT components (component+)>
<!ELEMENT component (limiter+)>
<!ATTLIST component
          name CDATA #REQUIRED
          tempType CDATA #REQUIRED>
<!ELEMENT scenarios (scenario*, scenario_group*)>
<!ELEMENT scenario (limiter*)>
<!ATTLIST scenario
          name CDATA #IMPLIED
          id CDATA #IMPLIED
          limiter CDATA #IMPLIED
          tempType CDATA #IMPLIED
          priority CDATA "0"
          region CDATA #IMPLIED
          step CDATA "-1"
          delay CDATA "0"
          cond (sensor_check|for_request|for_temporary) #IMPLIED
          temp CDATA #IMPLIED
          gap CDATA "20"
          value CDATA #IMPLIED>
<!ELEMENT scenario_group (scenario+)>
<!ELEMENT limiter EMPTY>
<!ATTLIST limiter
          name CDATA #REQUIRED
          step CDATA "-1"
          delay CDATA "0"
          cond (sensor_check|for_request|for_temporary) #IMPLIED
          temp CDATA #IMPLIED
          gap CDATA "20"
          value CDATA #IMPLIED
          multistage CDATA #IMPLIED
          hvmode CDATA #IMPLIED
          p CDATA #IMPLIED
          i CDATA #IMPLIED
          d CDATA #IMPLIED
          unit CDATA #IMPLIED
          min CDATA #IMPLIED
          max CDATA #IMPLIED
          tempType CDATA #IMPLIED>
]>

